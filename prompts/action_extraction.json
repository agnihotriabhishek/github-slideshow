{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ActionExtraction",
  "description": "Structured output for next steps, tasks, contacts, and intent.",
  "type": "object",
  "properties": {
    "intent": { "type": "string", "enum": ["sales_qualification", "support_issue", "billing", "general_inquiry", "other"] },
    "summary": { "type": "string" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "next_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "due_date": { "type": ["string", "null"], "format": "date-time" },
          "assignee": { "type": ["string", "null"] }
        },
        "required": ["title"]
      }
    },
    "contacts": {
      "type": "object",
      "properties": {
        "name": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"], "format": "email" },
        "phone": { "type": ["string", "null"] }
      }
    }
  },
  "required": ["intent", "summary", "next_steps"]
}
